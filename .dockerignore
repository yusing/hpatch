# Send only build inputs, never local benchmark repositories or credentials.
**
!go.mod
!go.sum
!*.go
!tool_grammar.lark
!cmd/
!cmd/**
!capturer/
!capturer/**
!internal/
!internal/**
!contrib/
!contrib/codex/
!contrib/codex/**
!benchmarks/
!benchmarks/Dockerfile
!benchmarks/*.sh
!benchmarks/*.py
!benchmarks/cmd/
!benchmarks/cmd/**
**/node_modules
**/.git
**/.env*
**/auth.json
**/*.log
