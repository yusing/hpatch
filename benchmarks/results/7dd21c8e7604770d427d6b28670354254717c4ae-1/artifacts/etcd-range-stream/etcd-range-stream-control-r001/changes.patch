+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) error {
+	req := *r
+	total, currentRevision, err := txn.Count(ctx, s.KV(), &req)
+	if err != nil {
+		return err
+	}
+	pinnedRevision := req.Revision
+	if pinnedRevision == 0 {
+		pinnedRevision = currentRevision
+	}
+	req.Revision = pinnedRevision
+
+	wanted := total
+	if req.Limit > 0 && req.Limit < wanted {
+		wanted = req.Limit
+	}
+	more := req.Limit > 0 && total > req.Limit
+
+	if req.CountOnly || wanted == 0 {
+		if req.CountOnly {
+			more = false
+		}
+		return send(&pb.RangeStreamResponse{
+			RangeResponse: &pb.RangeResponse{
+				Header: &pb.ResponseHeader{Revision: pinnedRevision},
+				More:   more,
+				Count:  total,
+			},
+		})
+	}
+
+	chunkLimit := initialRangeStreamChunkLimit
+	maxBytes := int64(s.Cfg.MaxRequestBytes)
+	if maxBytes < 1 {
+		maxBytes = 1
+	}
+	remaining := wanted
+	for remaining > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		limit := chunkLimit
+		if limit < 1 {
+			limit = 1
+		}
+		if limit > remaining {
+			limit = remaining
+		}
+		req.Limit = limit
+
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+		if err != nil {
+			return err
+		}
+		if len(resp.Kvs) == 0 {
+			// The initial count and all chunks use the same revision, so an
+			// empty page before remaining reaches zero indicates cancellation
+			// or an inconsistent storage result; avoid spinning indefinitely.
+			return errorspkg.New("range stream returned an empty non-final chunk")
+		}
+
+		remaining -= int64(len(resp.Kvs))
+		final := remaining == 0
+		if final {
+			resp.Header.Revision = pinnedRevision
+			resp.More = more
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+		chunk := &pb.RangeStreamResponse{RangeResponse: resp}
+		if err := send(chunk); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		req.Key = make([]byte, len(lastKey)+1)
+		copy(req.Key, lastKey)
+
+		responseBytes := int64(chunk.Size())
+		if responseBytes > 0 {
+			ratio := float64(maxBytes) / float64(responseBytes)
+			adjusted := int64(1)
+			if ratio >= float64(math.MaxInt64)/float64(limit) {
+				adjusted = math.MaxInt64
+			} else {
+				adjusted = int64(float64(limit) * ratio)
+			}
+			if adjusted < 1 {
+				adjusted = 1
+			}
+			chunkLimit = adjusted
+		}
+	}
+	return nil
+}
