+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeResponse) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+
+	var streamErr error
+	get := func() {
+		streamErr = s.rangeStream(ctx, r, send)
+	}
+	serializeErr := s.doSerialize(ctx, chk, get)
+	if streamErr != nil {
+		return streamErr
+	}
+	return serializeErr
+}
+
+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeResponse) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	total, readRevision, err := txn.Count(ctx, s.Logger(), s.KV(), r)
+	if err != nil {
+		return err
+	}
+
+	revision := r.Revision
+	if revision == 0 {
+		revision = readRevision
+	}
+
+	if r.CountOnly || total == 0 {
+		return send(&pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: revision},
+			Count:  total,
+		})
+	}
+
+	toSend := total
+	if r.Limit > 0 && r.Limit < toSend {
+		toSend = r.Limit
+	}
+
+	chunkLimit := rangeStreamChunkLimit(s.Cfg.MaxRequestBytes)
+	request := *r
+	request.Revision = revision
+	request.CountOnly = false
+	request.Limit = chunkLimit
+
+	var sent int64
+	for sent < toSend {
+		remaining := toSend - sent
+		if chunkLimit > remaining {
+			request.Limit = remaining
+		} else {
+			request.Limit = chunkLimit
+		}
+
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &request, false)
+		if err != nil {
+			return err
+		}
+		resp.Header.Revision = revision
+
+		n := int64(len(resp.Kvs))
+		sent += n
+		final := sent >= toSend || n == 0
+		if final {
+			resp.Header.Revision = revision
+			resp.More = total > toSend
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+
+		if err := send(resp); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		request.Key = append(append([]byte(nil), lastKey...), 0)
+		chunkLimit = adaptRangeStreamChunkLimit(chunkLimit, proto.Size(resp), s.Cfg.MaxRequestBytes)
+	}
+
+	return nil
+}
+
+func rangeStreamChunkLimit(maxRequestBytes uint) int64 {
+	limit := int64(maxRequestBytes / 1024)
+	if limit < 1 {
+		return 1
+	}
+	if limit > maxRangeStreamChunkLimit {
+		return maxRangeStreamChunkLimit
+	}
+	return limit
+}
+
+func adaptRangeStreamChunkLimit(limit int64, responseBytes int, maxRequestBytes uint) int64 {
+	if limit < 1 {
+		limit = 1
+	}
+	if responseBytes <= 0 || maxRequestBytes == 0 {
+		return limit
+	}
+
+	scaled := float64(limit) * float64(maxRequestBytes) / float64(responseBytes)
+	if scaled < 1 {
+		return 1
+	}
+	if scaled >= float64(maxRangeStreamChunkLimit) {
+		return maxRangeStreamChunkLimit
+	}
+	return int64(scaled)
+}
