+// RangeStream reads bounded batches at one revision. Network sends happen outside
+// the storage read transactions so slow clients do not hold backend locks.
+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx, _ := traceutil.EnsureTrace(stream.Context(), s.Logger(), "range-stream")
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+	req := *r
+	limit := int64(10)
+	if r.Limit > 0 && r.Limit < limit {
+		limit = r.Limit
+	}
+	remaining := r.Limit
+	var delivered int64
+	var header *pb.ResponseHeader
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		req.Limit = limit
+		var resp *pb.RangeResponse
+		var err error
+		if serr := s.doSerialize(ctx, chk, func() {
+			resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+		}); serr != nil {
+			return serr
+		}
+		if err != nil {
+			return err
+		}
+		if header == nil {
+			header = resp.Header
+			if req.Revision <= 0 {
+				req.Revision = header.Revision
+			}
+		}
+		delivered += int64(len(resp.Kvs))
+		if r.Limit > 0 {
+			remaining -= int64(len(resp.Kvs))
+		}
+		final := r.CountOnly || !resp.More || (r.Limit > 0 && remaining == 0)
+		size := resp.Size()
+		if final {
+			resp.Header = header
+			if !r.CountOnly {
+				resp.Count = delivered
+				if resp.More {
+					countReq := *r
+					countReq.Revision = req.Revision
+					if serr := s.doSerialize(ctx, chk, func() {
+						resp.Count, err = txn.Count(ctx, s.Logger(), s.KV(), &countReq)
+					}); serr != nil {
+						return serr
+					}
+					if err != nil {
+						return err
+					}
+				}
+			}
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+		// Appending a NUL advances past the last key without skipping any key.
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		req.Key = append(append([]byte(nil), lastKey...), 0)
+		target := int64(s.Cfg.MaxRequestBytes)
+		if int64(size) > target {
+			limit = max(1, limit/2)
+		} else if int64(size) < target {
+			// A key occupies at least one byte, so the target also bounds growth.
+			limit = min(limit*2, max(1, target))
+		}
+		if r.Limit > 0 {
+			limit = min(limit, remaining)
+		}
+	}
+}
