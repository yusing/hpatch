+// rangeStreamHeaderServer fills metadata only on the final response header.
+type rangeStreamHeaderServer struct {
+	pb.KV_RangeStreamServer
+	hdr     *header
+	sendErr error
+}
+
+func (s *rangeStreamHeaderServer) Send(resp *pb.RangeStreamResponse) error {
+	if rh := resp.GetRangeResponse().GetHeader(); rh != nil {
+		rh.ClusterId = uint64(s.hdr.clusterID)
+		rh.MemberId = uint64(s.hdr.memberID)
+		rh.RaftTerm = s.hdr.sg.Term()
+	}
+	s.sendErr = s.KV_RangeStreamServer.Send(resp)
+	return s.sendErr
+}
