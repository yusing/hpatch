+	err := s.kv.RangeStream(r, wrapped)
+	if wrapped.sendErr != nil {
+		return wrapped.sendErr
+	}
+	if err == nil {
+		return nil
+	}
+	if _, ok := status.FromError(err); ok {
+		return err
+	}
+	return togRPCError(err)
