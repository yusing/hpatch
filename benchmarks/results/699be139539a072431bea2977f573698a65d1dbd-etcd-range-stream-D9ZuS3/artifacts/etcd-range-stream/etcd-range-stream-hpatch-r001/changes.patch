+// RangeStream reads bounded batches at a single revision in ascending key order.
+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx := stream.Context()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	req := *r
+	if r.CountOnly {
+		resp, err := s.Range(ctx, &req)
+		if err != nil {
+			return err
+		}
+		if r.Revision > 0 {
+			resp.Header.Revision = r.Revision
+		}
+		return stream.Send(&pb.RangeStreamResponse{RangeResponse: resp})
+	}
+
+	req.Limit = 10
+	if r.Limit > 0 && r.Limit < req.Limit {
+		req.Limit = r.Limit
+	}
+	var sent, total int64
+	first := true
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		var resp *pb.RangeResponse
+		var err error
+		if first {
+			resp, err = s.Range(ctx, &req)
+		} else {
+			ctx, _ = traceutil.EnsureTrace(ctx, s.Logger(), "range stream")
+			chk := func(ai *auth.AuthInfo) error {
+				return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+			}
+			get := func() {
+				resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+			}
+			if serr := s.doSerialize(ctx, chk, get); serr != nil {
+				return serr
+			}
+		}
+		if err != nil {
+			return err
+		}
+		if first {
+			total = resp.Count
+			if req.Revision <= 0 {
+				req.Revision = resp.Header.Revision
+			}
+			first = false
+		}
+		sent += int64(len(resp.Kvs))
+		final := !resp.More || (r.Limit > 0 && sent >= r.Limit)
+		size := int64(resp.Size())
+		if final {
+			resp.Header.Revision = req.Revision
+			resp.Count = total
+			resp.More = sent < total
+		} else {
+			resp.Header = nil
+			resp.Count = 0
+			resp.More = false
+			req.Key = append(append([]byte(nil), resp.Kvs[len(resp.Kvs)-1].Key...), 0)
+		}
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		// MaxRequestBytes is a target: a single key may exceed it.
+		target := int64(s.Cfg.MaxRequestBytes)
+		if size > target {
+			req.Limit = max(1, req.Limit/2)
+		} else if size < target && req.Limit <= (1<<63-1)/2 {
+			req.Limit *= 2
+		}
+		if r.Limit > 0 {
+			req.Limit = min(req.Limit, r.Limit-sent)
+		}
+	}
+}
