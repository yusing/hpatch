+// RangeStream serves a range in bounded, key-ordered chunks. An implicit
+// revision is resolved once and used for every chunk.
+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeResponse) error) error {
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	checkPermission := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+
+	var countResponse *pb.RangeResponse
+	var countErr error
+	count := func() {
+		countResponse, _, countErr = txn.Count(ctx, s.Logger(), s.KV(), r)
+	}
+	if err := s.doSerialize(ctx, checkPermission, count); err != nil {
+		return err
+	}
+	if countErr != nil {
+		return countErr
+	}
+
+	totalCount := countResponse.Count
+	readRevision := r.Revision
+	if readRevision == 0 {
+		readRevision = countResponse.Header.Revision
+	}
+
+	if r.CountOnly || totalCount == 0 {
+		countResponse.Header.Revision = readRevision
+		return send(countResponse)
+	}
+
+	request := *r
+	request.Revision = readRevision
+	request.CountOnly = false
+
+	remaining := totalCount
+	if request.Limit > 0 && request.Limit < remaining {
+		remaining = request.Limit
+	}
+
+	targetBytes := int64(s.Cfg.MaxRequestBytes)
+	if targetBytes < 1 {
+		targetBytes = 1
+	}
+	chunkLimit := targetBytes / 512
+	if chunkLimit < 1 {
+		chunkLimit = 1
+	}
+
+	for remaining > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if chunkLimit > remaining {
+			chunkLimit = remaining
+		}
+		request.Limit = chunkLimit
+
+		response, _, err := txn.Range(ctx, s.Logger(), s.KV(), &request, false)
+		if err != nil {
+			return err
+		}
+		if len(response.Kvs) == 0 {
+			response.Header = countResponse.Header
+			response.Count = totalCount
+			response.More = request.Limit < remaining
+			return send(response)
+		}
+
+		n := int64(len(response.Kvs))
+		remaining -= n
+		final := remaining == 0
+		if final {
+			response.Header = countResponse.Header
+			response.Header.Revision = readRevision
+			response.Count = totalCount
+			response.More = r.Limit > 0 && r.Limit < totalCount
+		} else {
+			response.Header = nil
+			response.Count = 0
+			response.More = false
+		}
+
+		if err := send(response); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := response.Kvs[len(response.Kvs)-1].Key
+		request.Key = make([]byte, len(lastKey)+1)
+		copy(request.Key, lastKey)
+
+		responseSize := int64(proto.Size(&pb.RangeStreamResponse{RangeResponse: response}))
+		if responseSize > targetBytes {
+			divisor := responseSize / targetBytes
+			if responseSize%targetBytes != 0 {
+				divisor++
+			}
+			chunkLimit /= divisor
+		} else if responseSize > 0 {
+			factor := targetBytes / responseSize
+			if factor > remaining/chunkLimit {
+				chunkLimit = remaining
+			} else {
+				chunkLimit *= factor
+			}
+		}
+		if chunkLimit < 1 {
+			chunkLimit = 1
+		}
+
+	}
+	return nil
+}
