+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) (err error) {
+	if !r.Serializable {
+		if err = s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	stream := func() {
+		err = s.rangeStream(ctx, r, send)
+	}
+	if serr := s.doSerialize(ctx, chk, stream); serr != nil {
+		return serr
+	}
+	return err
+}
+
+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	total, readRevision, err := txn.Count(ctx, s.KV(), r)
+	if err != nil {
+		return err
+	}
+
+	// A non-positive revision means "latest" to MVCC. Resolve it once so every
+	// chunk observes the same snapshot.
+	pinnedRevision := r.Revision
+	if pinnedRevision <= 0 {
+		pinnedRevision = readRevision
+	}
+
+	more := r.Limit > 0 && total > r.Limit
+	resultCount := total
+	if more {
+		resultCount = r.Limit
+	}
+	if r.CountOnly || resultCount == 0 {
+		if r.CountOnly {
+			more = false
+		}
+		return send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: pinnedRevision},
+			More:   more,
+			Count:  total,
+		}})
+	}
+
+	maxBytes := int64(s.Cfg.MaxRequestBytes)
+	if maxBytes < 1 {
+		maxBytes = 1
+	}
+	chunkLimit := int64(1)
+	remaining := resultCount
+	key := append([]byte(nil), r.Key...)
+	for remaining > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		limit := chunkLimit
+		if limit > remaining {
+			limit = remaining
+		}
+		req := *r
+		req.Key = key
+		req.Limit = limit
+		req.Revision = pinnedRevision
+		req.CountOnly = false
+
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+		if err != nil {
+			return err
+		}
+		if len(resp.Kvs) == 0 {
+			return errorspkg.New("range stream made no progress")
+		}
+
+		remaining -= int64(len(resp.Kvs))
+		final := remaining == 0
+		if final {
+			resp.Header.Revision = pinnedRevision
+			resp.More = more
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+		if err := send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		key = make([]byte, len(lastKey)+1)
+		copy(key, lastKey)
+
+		// Use the observed encoded size to aim the next chunk at the server's
+		// configured request-size bound. Keep the limit positive and bounded.
+		if size := int64(resp.Size()); size > 0 {
+			next := int64(float64(limit) * float64(maxBytes) / float64(size))
+			if next < 1 {
+				next = 1
+			}
+			if next > remaining {
+				next = remaining
+			}
+			chunkLimit = next
+		}
+	}
+	return nil
+}
