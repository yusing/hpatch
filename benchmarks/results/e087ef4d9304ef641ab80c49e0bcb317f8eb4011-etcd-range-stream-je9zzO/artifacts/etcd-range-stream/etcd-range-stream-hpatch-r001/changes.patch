+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx := stream.Context()
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+
+	var streamErr error
+	get := func() {
+		count, revision, err := txn.RangeCount(ctx, s.Logger(), s.KV(), r)
+		if err != nil {
+			streamErr = err
+			return
+		}
+		if r.Revision != 0 {
+			revision = r.Revision
+		}
+
+		sendFinal := func(resp *pb.RangeResponse) {
+			resp.Header = &pb.ResponseHeader{Revision: revision}
+			resp.Count = count
+			streamErr = stream.Send(&pb.RangeStreamResponse{RangeResponse: resp})
+		}
+
+		if r.CountOnly || count == 0 {
+			sendFinal(&pb.RangeResponse{})
+			return
+		}
+
+		remaining := count
+		if r.Limit > 0 && r.Limit < remaining {
+			remaining = r.Limit
+		}
+
+		req := *r
+		req.Revision = revision
+		req.CountOnly = false
+		chunkLimit := int64(s.Cfg.MaxRequestBytes / 1024)
+		if chunkLimit < 1 {
+			chunkLimit = 1
+		}
+		var sent int64
+		for sent < remaining {
+			req.Limit = chunkLimit
+			if req.Limit > remaining-sent {
+				req.Limit = remaining - sent
+			}
+
+			resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+			if err != nil {
+				streamErr = err
+				return
+			}
+			if len(resp.Kvs) == 0 {
+				sendFinal(resp)
+				return
+			}
+
+			sent += int64(len(resp.Kvs))
+			final := sent >= remaining
+			if final {
+				resp.Header = &pb.ResponseHeader{Revision: revision}
+				resp.Count = count
+				resp.More = count > sent
+			} else {
+				resp.Header = nil
+				resp.Count = 0
+				resp.More = false
+			}
+
+			streamErr = stream.Send(&pb.RangeStreamResponse{RangeResponse: resp})
+			if streamErr != nil || final {
+				return
+			}
+
+			responseSize := resp.Size()
+			if responseSize > 0 {
+				nextLimit := chunkLimit * int64(s.Cfg.MaxRequestBytes) / int64(responseSize)
+				if nextLimit < 1 {
+					nextLimit = 1
+				}
+				chunkLimit = nextLimit
+			}
+			lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+			req.Key = append(append([]byte(nil), lastKey...), 0)
+		}
+	}
+
+	if err := s.doSerialize(ctx, chk, get); err != nil {
+		return err
+	}
