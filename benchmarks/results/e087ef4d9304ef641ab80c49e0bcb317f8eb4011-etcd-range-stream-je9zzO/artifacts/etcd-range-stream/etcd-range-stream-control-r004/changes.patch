+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) (err error) {
+	if !r.Serializable {
+		if err = s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	stream := func() {
+		countResp, _, countErr := txn.Count(ctx, s.Logger(), s.KV(), r)
+		if countErr != nil {
+			err = countErr
+			return
+		}
+
+		pinnedRevision := r.Revision
+		if pinnedRevision == 0 {
+			pinnedRevision = countResp.Header.Revision
+		}
+		total := countResp.Count
+		more := r.Limit > 0 && total > r.Limit
+		remaining := total
+		if more {
+			remaining = r.Limit
+		}
+
+		if r.CountOnly {
+			countResp.Header.Revision = pinnedRevision
+			err = send(&pb.RangeStreamResponse{RangeResponse: countResp})
+			return
+		}
+		if remaining == 0 {
+			countResp.Header.Revision = pinnedRevision
+			countResp.More = more
+			err = send(&pb.RangeStreamResponse{RangeResponse: countResp})
+			return
+		}
+
+		request := *r
+		request.Revision = pinnedRevision
+		request.CountOnly = false
+		request.Limit = 1
+		request.Key = append([]byte(nil), r.Key...)
+
+		maxBytes := int64(s.Cfg.MaxRequestBytes)
+		if maxBytes < 1 {
+			maxBytes = 1
+		}
+		for remaining > 0 {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				err = ctxErr
+				return
+			}
+			if request.Limit > remaining {
+				request.Limit = remaining
+			}
+
+			var resp *pb.RangeResponse
+			resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), &request, false)
+			if err != nil {
+				return
+			}
+			if len(resp.Kvs) == 0 {
+				// The count and all page reads use the same revision, so this can
+				// only happen if the request selected no more keys.
+				remaining = 0
+			}
+
+			remaining -= int64(len(resp.Kvs))
+			final := remaining == 0
+			if final {
+				resp.Header.Revision = pinnedRevision
+				resp.More = more
+				resp.Count = total
+			} else {
+				resp.Header = nil
+				resp.More = false
+				resp.Count = 0
+			}
+
+			chunk := &pb.RangeStreamResponse{RangeResponse: resp}
+			if err = send(chunk); err != nil {
+				return
+			}
+			if final {
+				return
+			}
+
+			lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+			request.Key = make([]byte, len(lastKey)+1)
+			copy(request.Key, lastKey)
+
+			chunkBytes := int64(chunk.Size())
+			if chunkBytes < 1 {
+				chunkBytes = 1
+			}
+			nextLimit := remaining
+			if request.Limit <= math.MaxInt64/maxBytes {
+				nextLimit = request.Limit * maxBytes / chunkBytes
+			}
+			if nextLimit < 1 {
+				nextLimit = 1
+			} else if nextLimit == request.Limit && chunkBytes < maxBytes {
+				nextLimit++
+			}
+			if nextLimit > remaining {
+				nextLimit = remaining
+			}
+			request.Limit = nextLimit
+		}
+	}
+	if serr := s.doSerialize(ctx, chk, stream); serr != nil {
+		return serr
+	}
+	return err
+}
