+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx := stream.Context()
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	var streamErr error
+	if err := s.doSerialize(ctx, chk, func() {
+		streamErr = s.rangeStream(ctx, r, stream)
+	}); streamErr != nil {
+		return streamErr
+	} else if err != nil {
+		return err
+	}
+	return nil
+}
+
+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	total, revision, err := txn.Count(ctx, s.Logger(), s.KV(), r)
+	if err != nil {
+		return err
+	}
+
+	finalMore := !r.CountOnly && r.Limit > 0 && r.Limit < total
+	resultLimit := total
+	if finalMore {
+		resultLimit = r.Limit
+	}
+	if r.CountOnly || resultLimit == 0 {
+		return stream.Send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: revision},
+			More:   finalMore,
+			Count:  total,
+		}})
+	}
+
+	request := *r
+	request.Revision = revision
+	request.CountOnly = false
+	request.Limit = 1
+	var sent int64
+	maxChunkBytes := uint64(s.Cfg.MaxRequestBytes)
+	if maxChunkBytes == 0 {
+		maxChunkBytes = 1
+	}
+
+	for sent < resultLimit {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+		}
+
+		remaining := resultLimit - sent
+		if request.Limit > remaining {
+			request.Limit = remaining
+		}
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &request, false)
+		if err != nil {
+			return err
+		}
+		chunkCount := int64(len(resp.Kvs))
+		final := chunkCount == 0 || sent+chunkCount >= resultLimit
+		if final {
+			resp.More = finalMore
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+
+		responseSize := uint64(resp.Size())
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		sent += chunkCount
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		request.Key = append(append([]byte(nil), lastKey...), 0)
+		request.Limit = adaptedRangeStreamLimit(request.Limit, chunkCount, responseSize, maxChunkBytes)
+	}
+	return nil
+}
+
+func adaptedRangeStreamLimit(current, count int64, responseBytes, targetBytes uint64) int64 {
+	if current < 1 {
+		current = 1
+	}
+	if count < 1 || responseBytes == 0 {
+		return current
+	}
+	if targetBytes > math.MaxUint64/uint64(count) {
+		return math.MaxInt64
+	}
+	next := uint64(count) * targetBytes / responseBytes
+	if next < 1 {
+		next = 1
+	}
+	if next > math.MaxInt64 {
+		return math.MaxInt64
+	}
+	return int64(next)
+}
