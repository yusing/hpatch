+// Count returns the number of keys in the requested range and the revision at
+// which the count was evaluated. It deliberately ignores the request limit;
+// callers use it to pin and describe a complete range result.
+func Count(ctx context.Context, lg *zap.Logger, kv mvcc.KV, r *pb.RangeRequest) (count, revision int64, err error) {
+	ctx, trace := traceutil.EnsureTrace(ctx, lg, "range count")
+	txnRead := kv.Read(mvcc.ConcurrentReadTxMode, trace)
+	defer txnRead.End()
+
+	countRequest := *r
+	countRequest.Limit = 0
+	countRequest.CountOnly = true
+	resp, err := executeRange(ctx, lg, txnRead, &countRequest, false)
+	if err != nil {
+		return 0, 0, err
+	}
+	return resp.Count, resp.Header.Revision, nil
+}
