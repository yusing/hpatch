+// RangeStream reads a range in bounded, key-ordered chunks. The preliminary
+// count resolves an implicit revision, so every chunk observes one snapshot.
+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) error {
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	var streamErr error
+	get := func() {
+		streamErr = s.rangeStream(ctx, r, send)
+	}
+	if err := s.doSerialize(ctx, chk, get); err != nil {
+		return err
+	}
+	return streamErr
+}
+
+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) error {
+	count, revision, err := txn.Count(ctx, s.Logger(), s.KV(), r)
+	if err != nil {
+		return err
+	}
+	if r.Revision != 0 {
+		revision = r.Revision
+	}
+	finalMore := !r.CountOnly && r.Limit > 0 && count > r.Limit
+	wanted := count
+	if finalMore {
+		wanted = r.Limit
+	}
+	if r.CountOnly || wanted == 0 {
+		return send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: revision},
+			More:   finalMore,
+			Count:  count,
+		}})
+	}
+
+	maxBytes := int64(s.Cfg.MaxRequestBytes)
+	if maxBytes < 1 {
+		maxBytes = 1
+	}
+	chunkLimit := int64(1)
+	emitted := int64(0)
+	key := append([]byte(nil), r.Key...)
+	for emitted < wanted {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		remaining := wanted - emitted
+		if chunkLimit > remaining {
+			chunkLimit = remaining
+		}
+		if chunkLimit < 1 {
+			chunkLimit = 1
+		}
+
+		req := *r
+		req.Key = key
+		req.Revision = revision
+		req.Limit = chunkLimit
+		req.CountOnly = false
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+		if err != nil {
+			return err
+		}
+		if len(resp.Kvs) == 0 {
+			// The snapshot cannot lose keys. Treat an empty result as completion
+			// nevertheless, avoiding a non-progressing stream on a malformed range.
+			resp.Header = &pb.ResponseHeader{Revision: revision}
+			resp.More = finalMore
+			resp.Count = count
+			return send(&pb.RangeStreamResponse{RangeResponse: resp})
+		}
+
+		emitted += int64(len(resp.Kvs))
+		final := emitted >= wanted
+		if final {
+			resp.Header = &pb.ResponseHeader{Revision: revision}
+			resp.More = finalMore
+			resp.Count = count
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+		if err := send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		key = make([]byte, len(lastKey)+1)
+		copy(key, lastKey)
+
+		responseBytes := int64(resp.Size())
+		if responseBytes < 1 {
+			responseBytes = 1
+		}
+		nextLimit := int64(len(resp.Kvs)) * maxBytes / responseBytes
+		if nextLimit < 1 {
+			nextLimit = 1
+		}
+		chunkLimit = nextLimit
+	}
+	return nil
+}
