+// Count returns the number of keys selected by r and the revision at which
+// they were counted. An unspecified revision is resolved while the read
+// transaction is open so callers can use the same snapshot for later reads.
+func Count(ctx context.Context, kv mvcc.KV, r *pb.RangeRequest) (int64, int64, error) {
+	txnRead := kv.Read(mvcc.ConcurrentReadTxMode, traceutil.Get(ctx))
+	defer txnRead.End()
+
+	rev := r.Revision
+	if rev == 0 {
+		rev = txnRead.Rev()
+	}
+	rr, err := txnRead.Range(ctx, r.Key, mkGteRange(r.RangeEnd), mvcc.RangeOptions{
+		Rev:       rev,
+		CountOnly: true,
+	})
+	if err != nil {
+		return 0, 0, err
+	}
+	return int64(rr.Count), rev, nil
+}
