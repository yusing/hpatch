+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) error {
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	checkAuth := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+
+	var (
+		total     int64
+		pinnedRev int64
+		countErr  error
+	)
+	count := func() {
+		total, pinnedRev, countErr = txn.Count(ctx, s.KV(), r)
+	}
+	if err := s.doSerialize(ctx, checkAuth, count); err != nil {
+		return err
+	}
+	if countErr != nil {
+		return countErr
+	}
+
+	finalCount := total
+	if r.Limit > 0 && finalCount > r.Limit {
+		finalCount = r.Limit
+	}
+	more := finalCount < total
+
+	if r.CountOnly {
+		return send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: pinnedRev},
+			Count:  total,
+		}})
+	}
+	if finalCount == 0 {
+		return send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: pinnedRev},
+			More:   more,
+			Count:  total,
+		}})
+	}
+
+	request := *r
+	request.Revision = pinnedRev
+	request.Serializable = true
+	request.CountOnly = false
+
+	maxBytes := int64(s.Cfg.MaxRequestBytes)
+	if maxBytes < 1 {
+		maxBytes = 1
+	}
+	chunkLimit := maxBytes / 512
+	if chunkLimit < 1 {
+		chunkLimit = 1
+	}
+	if chunkLimit > finalCount {
+		chunkLimit = finalCount
+	}
+
+	var sent int64
+	for sent < finalCount {
+		remaining := finalCount - sent
+		if chunkLimit > remaining {
+			chunkLimit = remaining
+		}
+		request.Limit = chunkLimit
+
+		var (
+			resp     *pb.RangeResponse
+			rangeErr error
+		)
+		get := func() {
+			resp, _, rangeErr = txn.Range(ctx, s.Logger(), s.KV(), &request, false)
+		}
+		if err := s.doSerialize(ctx, checkAuth, get); err != nil {
+			return err
+		}
+		if rangeErr != nil {
+			return rangeErr
+		}
+		if len(resp.Kvs) == 0 {
+			return errorspkg.New("range stream made no progress")
+		}
+
+		n := int64(len(resp.Kvs))
+		sent += n
+		last := sent >= finalCount
+		chunk := &pb.RangeResponse{Kvs: resp.Kvs}
+		if last {
+			chunk.Header = &pb.ResponseHeader{Revision: pinnedRev}
+			chunk.More = more
+			chunk.Count = total
+		}
+		streamResp := &pb.RangeStreamResponse{RangeResponse: chunk}
+		if err := send(streamResp); err != nil {
+			return err
+		}
+
+		if last {
+			return nil
+		}
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		request.Key = append(append([]byte(nil), lastKey...), 0)
+
+		responseBytes := int64(proto.Size(streamResp))
+		if responseBytes < 1 {
+			responseBytes = 1
+		}
+		if chunkLimit > math.MaxInt64/maxBytes {
+			chunkLimit = math.MaxInt64
+		} else {
+			chunkLimit = chunkLimit * maxBytes / responseBytes
+		}
+		if chunkLimit < 1 {
+			chunkLimit = 1
+		}
+	}
+	return nil
+}
