+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	total, revision, err := txn.RangeCount(ctx, s.Logger(), s.KV(), r)
+	if err != nil {
+		return err
+	}
+
+	finalMore := !r.CountOnly && r.Limit > 0 && total > r.Limit
+	remaining := total
+	if r.Limit > 0 && remaining > r.Limit {
+		remaining = r.Limit
+	}
+	if r.CountOnly || remaining == 0 {
+		return stream.Send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: revision},
+			More:   finalMore,
+			Count:  total,
+		}})
+	}
+
+	maxChunkBytes := int64(s.Cfg.MaxRequestBytes)
+	if maxChunkBytes < 1 {
+		maxChunkBytes = 1
+	}
+	chunkLimit := int64(1)
+	nextKey := append([]byte(nil), r.Key...)
+
+	for remaining > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		limit := chunkLimit
+		if limit > remaining {
+			limit = remaining
+		}
+		if limit < 1 {
+			limit = 1
+		}
+
+		req := *r
+		req.Key = nextKey
+		req.Revision = revision
+		req.Limit = limit
+		req.CountOnly = false
+
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+		if err != nil {
+			return err
+		}
+		if len(resp.Kvs) == 0 {
+			resp.Header.Revision = revision
+			resp.More = finalMore
+			resp.Count = total
+			return stream.Send(&pb.RangeStreamResponse{RangeResponse: resp})
+		}
+
+		rawChunk := &pb.RangeStreamResponse{RangeResponse: resp}
+		if int64(rawChunk.Size()) > maxChunkBytes && len(resp.Kvs) > 1 {
+			nextLimit := limit * maxChunkBytes / int64(rawChunk.Size())
+			if nextLimit >= limit {
+				nextLimit = limit - 1
+			}
+			if nextLimit < 1 {
+				nextLimit = 1
+			}
+			chunkLimit = nextLimit
+			continue
+		}
+
+		n := int64(len(resp.Kvs))
+		remaining -= n
+		final := remaining == 0
+		if final {
+			resp.Header.Revision = revision
+			resp.More = finalMore
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+
+		chunk := &pb.RangeStreamResponse{RangeResponse: resp}
+		if err := stream.Send(chunk); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		nextKey = make([]byte, len(lastKey)+1)
+		copy(nextKey, lastKey)
+
+		chunkSize := int64(chunk.Size())
+		if chunkSize < 1 {
+			chunkSize = 1
+		}
+		if chunkLimit > maxChunkBytes/chunkSize {
+			chunkLimit = maxChunkBytes
+		} else {
+			chunkLimit = chunkLimit * maxChunkBytes / chunkSize
+		}
+		if chunkLimit < 1 {
+			chunkLimit = 1
+		}
+	}
+	return nil
+}
