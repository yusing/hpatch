+// RangeStream reads bounded batches at one revision, in ascending key order.
+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx := stream.Context()
+	req := *r
+	limit := int64(10)
+	if r.Limit > 0 && r.Limit < limit {
+		limit = r.Limit
+	}
+	var count, sent int64
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		req.Limit = limit
+		resp, err := s.rangeKeys(ctx, &req, sent == 0)
+		if err != nil {
+			return err
+		}
+		if sent == 0 {
+			count = resp.Count
+			if req.Revision <= 0 {
+				req.Revision = resp.Header.Revision
+			}
+		}
+		sent += int64(len(resp.Kvs))
+		last := r.CountOnly || !resp.More || (r.Limit > 0 && sent >= r.Limit)
+		size := resp.Size()
+		if last {
+			resp.Header.Revision = req.Revision
+			resp.Count = count
+		} else {
+			resp.Header = nil
+			resp.Count = 0
+			resp.More = false
+		}
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if last {
+			return nil
+		}
+		// Appending a zero byte selects the first key strictly after the last key.
+		req.Key = append(append([]byte(nil), resp.Kvs[len(resp.Kvs)-1].Key...), 0)
+		req.Serializable = true
+		target := int64(s.Cfg.MaxRequestBytes)
+		if int64(size) > target {
+			limit = max(1, limit/2)
+		} else if int64(size) < target/2 {
+			// Saturate growth to avoid ever producing an unlimited batch.
+			if limit <= (1<<63-1)/2 {
+				limit *= 2
+			}
+		}
+		if r.Limit > 0 {
+			limit = min(limit, r.Limit-sent)
+		}
+	}
+}
