+// RangeStream reads bounded batches at a single revision.
+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx, _ := traceutil.EnsureTrace(stream.Context(), s.Logger(), "range stream")
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+	req := *r
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	var resp *pb.RangeResponse
+	var err error
+	read := func(countOnly bool) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		get := func() {
+			if countOnly {
+				resp, _, err = txn.Count(ctx, s.Logger(), s.KV(), &req)
+			} else {
+				resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), &req, false)
+			}
+		}
+		if serr := s.doSerialize(ctx, chk, get); serr != nil {
+			return serr
+		}
+		return err
+	}
+	if err := read(true); err != nil {
+		return err
+	}
+	if req.Revision <= 0 {
+		req.Revision = resp.Header.Revision
+	}
+	resp.Header.Revision = req.Revision
+	header, total := resp.Header, resp.Count
+	if req.CountOnly {
+		return stream.Send(&pb.RangeStreamResponse{RangeResponse: resp})
+	}
+	limit := int64(10)
+	remaining := r.Limit
+	for {
+		if remaining > 0 && limit > remaining {
+			limit = remaining
+		}
+		req.Limit = limit
+		if err := read(false); err != nil {
+			return err
+		}
+		n := int64(len(resp.Kvs))
+		if remaining > 0 {
+			remaining -= n
+		}
+		final := !resp.More || (r.Limit > 0 && remaining == 0)
+		size := resp.Size()
+		if final {
+			resp.Header = header
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.Count = 0
+			resp.More = false
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+		req.Key = append(append([]byte(nil), resp.Kvs[len(resp.Kvs)-1].Key...), 0)
+		target := int64(s.Cfg.MaxRequestBytes)
+		if int64(size) > target {
+			limit = max(1, limit/2)
+		} else if int64(size) < target/2 && limit <= (1<<63-1)/2 {
+			limit *= 2
+		}
+	}
+}
