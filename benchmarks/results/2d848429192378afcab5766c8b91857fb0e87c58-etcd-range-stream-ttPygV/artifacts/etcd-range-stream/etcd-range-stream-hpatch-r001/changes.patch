+func (s *EtcdServer) RangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeStreamResponse) error) error {
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+
+	checkPermission := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	run := func(req *pb.RangeRequest, count bool) (*pb.RangeResponse, error) {
+		var resp *pb.RangeResponse
+		var err error
+		get := func() {
+			if count {
+				resp, _, err = txn.Count(ctx, s.Logger(), s.KV(), req)
+			} else {
+				resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), req, false)
+			}
+		}
+		if authErr := s.doSerialize(ctx, checkPermission, get); authErr != nil {
+			return nil, authErr
+		}
+		return resp, err
+	}
+
+	countResp, err := run(r, true)
+	if err != nil {
+		return err
+	}
+	revision := r.Revision
+	if revision == 0 {
+		revision = countResp.Header.Revision
+	}
+	countResp.Header.Revision = revision
+	total := countResp.Count
+
+	more := r.Limit > 0 && total > r.Limit
+	wanted := total
+	if r.Limit > 0 && r.Limit < wanted {
+		wanted = r.Limit
+	}
+
+	if r.CountOnly {
+		return send(&pb.RangeStreamResponse{RangeResponse: countResp})
+	}
+	if wanted == 0 {
+		countResp.More = more
+		return send(&pb.RangeStreamResponse{RangeResponse: countResp})
+	}
+
+	keyLimit := int64(10)
+	if r.Limit > 0 && r.Limit < keyLimit {
+		keyLimit = r.Limit
+	}
+	targetBytes := int64(s.Cfg.MaxRequestBytes)
+	if targetBytes < 1 {
+		targetBytes = 1
+	}
+
+	nextKey := append([]byte(nil), r.Key...)
+	var sent int64
+	for sent < wanted {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		remaining := wanted - sent
+		if keyLimit > remaining {
+			keyLimit = remaining
+		}
+		if keyLimit < 1 {
+			keyLimit = 1
+		}
+
+		req := *r
+		req.Key = nextKey
+		req.Revision = revision
+		req.Limit = keyLimit
+		req.CountOnly = false
+		resp, err := run(&req, false)
+		if err != nil {
+			return err
+		}
+		if len(resp.Kvs) == 0 {
+			return errorspkg.New("range stream made no progress")
+		}
+
+		n := int64(len(resp.Kvs))
+		sent += n
+		last := resp.Kvs[len(resp.Kvs)-1].Key
+		nextKey = make([]byte, len(last)+1)
+		copy(nextKey, last)
+
+		final := sent >= wanted
+		chunkResp := &pb.RangeResponse{Kvs: resp.Kvs}
+		if final {
+			chunkResp.Header = &pb.ResponseHeader{Revision: revision}
+			chunkResp.More = more
+			chunkResp.Count = total
+		}
+		chunk := &pb.RangeStreamResponse{RangeResponse: chunkResp}
+		chunkBytes := int64(chunk.Size())
+		if err := send(chunk); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		if chunkBytes > targetBytes && keyLimit > 1 {
+			keyLimit = keyLimit * targetBytes / chunkBytes
+			if keyLimit < 1 {
+				keyLimit = 1
+			}
+		} else if chunkBytes < targetBytes {
+			if chunkBytes < 1 {
+				chunkBytes = 1
+			}
+			nextLimit := keyLimit * targetBytes / chunkBytes
+			if nextLimit <= keyLimit {
+				nextLimit = keyLimit + 1
+			}
+			keyLimit = nextLimit
+		}
+	}
+	return nil
+}
