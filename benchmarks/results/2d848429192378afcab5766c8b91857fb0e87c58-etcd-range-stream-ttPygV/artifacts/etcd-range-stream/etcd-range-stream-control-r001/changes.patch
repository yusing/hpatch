+func (s *EtcdServer) rangeStream(ctx context.Context, r *pb.RangeRequest, send func(*pb.RangeResponse) error) error {
+	total, revision, err := txn.Count(ctx, s.KV(), r)
+	if err != nil {
+		return err
+	}
+	if r.CountOnly {
+		return send(&pb.RangeResponse{Header: &pb.ResponseHeader{Revision: revision}, Count: total})
+	}
+
+	limit := rangeStreamInitialLimit
+	if r.Limit > 0 && r.Limit < limit {
+		limit = r.Limit
+	}
+	remaining := r.Limit
+	nextKey := append([]byte(nil), r.Key...)
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+		}
+
+		chunkLimit := limit
+		if remaining > 0 && chunkLimit > remaining {
+			chunkLimit = remaining
+		}
+		if chunkLimit < 1 {
+			chunkLimit = 1
+		}
+		chunkReq := *r
+		chunkReq.Key = nextKey
+		chunkReq.Revision = revision
+		chunkReq.Limit = chunkLimit
+		resp, _, err := txn.Range(ctx, s.Logger(), s.KV(), &chunkReq, false)
+		if err != nil {
+			return err
+		}
+
+		n := int64(len(resp.Kvs))
+		if remaining > 0 {
+			remaining -= n
+		}
+		final := !resp.More || (r.Limit > 0 && remaining == 0)
+		if final {
+			resp.Header = &pb.ResponseHeader{Revision: revision}
+			resp.Count = total
+			resp.More = r.Limit > 0 && total > r.Limit
+		} else {
+			resp.Header = nil
+			resp.Count = 0
+			resp.More = false
+		}
+		if err := send(resp); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		nextKey = make([]byte, len(lastKey)+1)
+		copy(nextKey, lastKey)
+		if bytes.Compare(nextKey, lastKey) <= 0 {
+			panic("range stream key successor did not advance")
+		}
+
+		sz := int64(resp.Size())
+		target := int64(s.Cfg.MaxRequestBytes)
+		if target < 1 {
+			target = 1
+		}
+		if sz > target {
+			limit /= 2
+			if limit < 1 {
+				limit = 1
+			}
+		} else if limit <= math.MaxInt64/2 {
+			limit *= 2
+		}
+		if remaining > 0 && limit > remaining {
+			limit = remaining
+		}
+	}
+}
