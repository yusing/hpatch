+// RevisionsWithMetadata returns limited key metadata from key(included) to
+// end(excluded) at the given revision. The total is not capped by limit when
+// withTotalCount is true.
+func (ti *treeIndex) RevisionsWithMetadata(key, end []byte, atRev int64, limit int, withTotalCount bool) (revs []keyRevision, total int) {
+	ti.RLock()
+	defer ti.RUnlock()
+
+	appendRevision := func(ki *keyIndex) bool {
+		modified, created, version, err := ki.get(ti.lg, atRev)
+		if err != nil {
+			return true
+		}
+		reachedLimit := limit > 0 && len(revs) >= limit
+		if reachedLimit {
+			if !withTotalCount {
+				return false
+			}
+		} else {
+			revs = append(revs, keyRevision{
+				key:      ki.key,
+				modified: modified,
+				created:  created,
+				version:  version,
+			})
+		}
+		total++
+		return true
+	}
+
+	if end == nil {
+		keyi := &keyIndex{key: key}
+		if keyi = ti.keyIndex(keyi); keyi != nil {
+			appendRevision(keyi)
+		}
+		return revs, total
+	}
+	ti.unsafeVisit(key, end, appendRevision)
+	return revs, total
+}
