+// RangeKeys returns the live keys and their metadata at atRev. It retains the
+// same limit and count semantics as Revisions, but avoids looking up values in
+// the backend.
+func (ti *treeIndex) RangeKeys(key, end []byte, atRev int64, limit int, withTotalCount bool) (kvs []indexKeyValue, total int) {
+	ti.RLock()
+	defer ti.RUnlock()
+
+	appendKey := func(k []byte, ki *keyIndex) bool {
+		modified, created, version, err := ki.get(ti.lg, atRev)
+		if err != nil {
+			return true
+		}
+		if limit <= 0 || len(kvs) < limit {
+			kvs = append(kvs, indexKeyValue{key: k, created: created, modified: modified, version: version})
+		} else if !withTotalCount {
+			return false
+		}
+		total++
+		return true
+	}
+
+	if end == nil {
+		keyi := &keyIndex{key: key}
+		if keyi = ti.keyIndex(keyi); keyi != nil {
+			appendKey(key, keyi)
+		}
+		return kvs, total
+	}
+	ti.unsafeVisit(key, end, func(ki *keyIndex) bool {
+		return appendKey(ki.key, ki)
+	})
+	return kvs, total
+}
+
+func indexKeyValuesToKeyValues(iks []indexKeyValue) []*mvccpb.KeyValue {
+	kvs := make([]*mvccpb.KeyValue, len(iks))
+	for i := range iks {
+		kvs[i] = &mvccpb.KeyValue{
+			Key:            iks[i].key,
+			CreateRevision: iks[i].created.Main,
+			ModRevision:    iks[i].modified.Main,
+			Version:        iks[i].version,
+		}
+	}
+	return kvs
+}
