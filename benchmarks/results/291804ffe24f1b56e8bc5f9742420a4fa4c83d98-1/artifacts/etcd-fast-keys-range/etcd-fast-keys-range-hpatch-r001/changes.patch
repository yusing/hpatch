+type indexRevision struct {
+	key      []byte
+	created  Revision
+	modified Revision
+	version  int64
+}
+
+func (ti *treeIndex) RevisionsWithMetadata(key, end []byte, atRev int64, limit int, withTotalCount bool) (revs []indexRevision, total int) {
+	ti.RLock()
+	defer ti.RUnlock()
+
+	if end == nil {
+		modified, created, version, err := ti.unsafeGet(key, atRev)
+		if err != nil {
+			return nil, 0
+		}
+		return []indexRevision{{key: key, created: created, modified: modified, version: version}}, 1
+	}
+	ti.unsafeVisit(key, end, func(ki *keyIndex) bool {
+		modified, created, version, err := ki.get(ti.lg, atRev)
+		if err != nil {
+			return true
+		}
+		reachedLimit := limit > 0 && len(revs) >= limit
+		if !reachedLimit {
+			revs = append(revs, indexRevision{
+				key:      ki.key,
+				created:  created,
+				modified: modified,
+				version:  version,
+			})
+		} else if !withTotalCount {
+			return false
+		}
+		total++
+		return true
+	})
+	return revs, total
+}
