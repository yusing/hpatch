+	}
+	var streamErr error
+	get := func() {
+		streamErr = txn.RangeStream(ctx, s.Logger(), s.KV(), r, s.Cfg.MaxRequestBytes, stream.Send)
+	}
+	serializeErr := s.doSerialize(ctx, chk, get)
+	if streamErr != nil {
+		return streamErr
+	}
+	return serializeErr
+}
