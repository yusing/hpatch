+		resp := streamResp.RangeResponse
+		if len(resp.Kvs) == 0 {
+			// A positive count and a bounded positive limit must make progress.
+			// Keep this guard to avoid looping forever if an MVCC implementation
+			// violates that contract.
+			return errorspkg.New("range stream returned no keys")
+		}
+		if err := send(streamResp); err != nil {
+			return err
+		}
+
+		n := int64(len(resp.Kvs))
+		remaining -= n
+		lastKey := resp.Kvs[len(resp.Kvs)-1].Key
+		request.Key = append(append([]byte(nil), lastKey...), 0)
+
+		sz := int64(streamResp.Size())
+		if maxRequestBytes > 0 && sz > 0 {
+			next := n * int64(maxRequestBytes) / sz
+			if next < 1 {
+				next = 1
+			}
+			if next == n && sz < int64(maxRequestBytes) {
+				next++
+			}
+			chunkLimit = next
+		}
+	}
+	return nil
+}
