+func Count(ctx context.Context, txnRead mvcc.ReadView, r *pb.RangeRequest) (int64, error) {
+	ro := mvcc.RangeOptions{Rev: r.Revision, CountOnly: true}
+	rr, err := txnRead.Range(ctx, r.Key, mkGteRange(r.RangeEnd), ro)
+	if err != nil {
+		return 0, err
+	}
+	return int64(rr.Count), nil
+}
+
+// RangeStream reads r from a single snapshot and sends it in key-ordered
+// chunks. maxRequestBytes is used as a target chunk size; a single key-value
+// pair is never split, even if it is larger than the target.
+func RangeStream(ctx context.Context, lg *zap.Logger, kv mvcc.KV, r *pb.RangeRequest, maxRequestBytes uint, send func(*pb.RangeStreamResponse) error) error {
+	ctx, trace := traceutil.EnsureTrace(ctx, lg, "range stream")
+	txnRead := kv.Read(mvcc.ConcurrentReadTxMode, trace)
+	defer txnRead.End()
+
+	total, err := Count(ctx, txnRead, r)
+	if err != nil {
+		return err
+	}
+	pinnedRevision := txnRead.Rev()
+	if r.CountOnly || total == 0 {
+		return send(&pb.RangeStreamResponse{RangeResponse: &pb.RangeResponse{
+			Header: &pb.ResponseHeader{Revision: pinnedRevision},
+			Count:  total,
+		}})
+	}
+
+	remaining := total
+	more := false
+	if r.Limit > 0 && r.Limit < remaining {
+		remaining = r.Limit
+		more = true
+	}
+
+	// Start with a conservative estimate of one key per KiB, then use each
+	// encoded response to steer the following chunk toward the byte target.
+	chunkLimit := int64(maxRequestBytes / 1024)
+	if chunkLimit < 1 {
+		chunkLimit = 1
+	}
+	request := *r
+	request.Revision = r.Revision
+	request.CountOnly = false
+	request.SortOrder = pb.RangeRequest_NONE
+	request.SortTarget = pb.RangeRequest_KEY
+	request.Limit = 0
+
+	for remaining > 0 {
+		limit := chunkLimit
+		if limit > remaining {
+			limit = remaining
+		}
+
+		var streamResp *pb.RangeStreamResponse
+		for {
+			request.Limit = limit
+			resp, err := executeRange(ctx, lg, txnRead, &request, false)
+			if err != nil {
+				return err
+			}
+			if int64(len(resp.Kvs)) > remaining {
+				resp.Kvs = resp.Kvs[:remaining]
+			}
+			final := int64(len(resp.Kvs)) == remaining
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+			if final {
+				resp.Header = &pb.ResponseHeader{Revision: pinnedRevision}
+				resp.More = more
+				resp.Count = total
+			}
+			streamResp = &pb.RangeStreamResponse{RangeResponse: resp}
+			sz := int64(streamResp.Size())
+			if maxRequestBytes == 0 || sz <= int64(maxRequestBytes) || limit == 1 {
+				break
+			}
+			newLimit := limit * int64(maxRequestBytes) / sz
+			if newLimit < 1 {
+				newLimit = 1
+			}
+			if newLimit >= limit {
+				newLimit = limit - 1
+			}
+			limit = newLimit
+		}
