+// RangeStream reads bounded batches at the revision selected by the first read.
+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx, _ := traceutil.EnsureTrace(stream.Context(), s.Logger(), "rangeStream")
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+
+	// Copy the request so pagination never changes the caller's request.
+	req := *r
+	req.Limit = 10
+	if r.Limit > 0 && r.Limit < req.Limit {
+		req.Limit = r.Limit
+	}
+	var header *pb.ResponseHeader
+	var total, sent int64
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		var resp *pb.RangeResponse
+		var err error
+		get := func() {
+			resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), &req, header == nil)
+		}
+		if err := s.doSerialize(ctx, chk, get); err != nil {
+			return err
+		}
+		if err != nil {
+			return err
+		}
+		if header == nil {
+			header = resp.Header
+			total = resp.Count
+			if req.Revision <= 0 {
+				req.Revision = header.Revision
+			}
+		}
+		sent += int64(len(resp.Kvs))
+		last := r.CountOnly || !resp.More || (r.Limit > 0 && sent >= r.Limit)
+		size := resp.Size()
+		if last {
+			resp.Header = header
+			resp.Count = total
+		} else {
+			resp.Header = nil
+			resp.Count = 0
+			resp.More = false
+			// Appending a zero byte gives the next possible key, including
+			// keys for which the last returned key is a prefix.
+			req.Key = append(append([]byte(nil), resp.Kvs[len(resp.Kvs)-1].Key...), 0)
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if last {
+			return nil
+		}
+
+		// The byte budget is a target: an individual value can exceed it.
+		// Halving oversized batches and doubling small ones avoids an
+		// unbounded read even when the request has no overall key limit.
+		target := int64(s.Cfg.MaxRequestBytes)
+		if int64(size) > target {
+			req.Limit = max(1, req.Limit/2)
+		} else if int64(size) < target/2 {
+			req.Limit = min(req.Limit*2, max(1, target))
+		}
+		if r.Limit > 0 {
+			req.Limit = min(req.Limit, r.Limit-sent)
+		}
+	}
+}
