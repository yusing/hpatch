+// RangeStream reads successive bounded ranges at a single revision.
+func (s *EtcdServer) RangeStream(r *pb.RangeRequest, stream pb.KV_RangeStreamServer) error {
+	ctx, _ := traceutil.EnsureTrace(stream.Context(), s.Logger(), "range stream")
+	if !r.Serializable {
+		if err := s.read.LinearizableReadNotify(ctx); err != nil {
+			return err
+		}
+	}
+	req := *r
+	limit := int64(10)
+	if r.Limit > 0 && r.Limit < limit {
+		limit = r.Limit
+	}
+	var sent int64
+	var header *pb.ResponseHeader
+	chk := func(ai *auth.AuthInfo) error {
+		return s.authStore.IsRangePermitted(ai, r.Key, r.RangeEnd)
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		req.Limit = limit
+		var resp *pb.RangeResponse
+		var err error
+		get := func() {
+			resp, _, err = txn.Range(ctx, s.Logger(), s.KV(), &req, r.CountOnly)
+		}
+		if serr := s.doSerialize(ctx, chk, get); serr != nil {
+			return serr
+		}
+		if err != nil {
+			return err
+		}
+		if header == nil {
+			header = resp.Header
+			if req.Revision <= 0 {
+				req.Revision = header.Revision
+			}
+		}
+		sent += int64(len(resp.Kvs))
+		final := r.CountOnly || !resp.More || (r.Limit > 0 && sent >= r.Limit)
+		size := resp.Size()
+		more := resp.More
+		if final {
+			if !r.CountOnly {
+				countReq := *r
+				countReq.Revision = req.Revision
+				getCount := func() {
+					resp.Count, err = txn.Count(ctx, s.Logger(), s.KV(), &countReq)
+				}
+				if serr := s.doSerialize(ctx, chk, getCount); serr != nil {
+					return serr
+				}
+				if err != nil {
+					return err
+				}
+			}
+			resp.Header = header
+		} else {
+			resp.Header = nil
+			resp.More = false
+			resp.Count = 0
+		}
+		if err := stream.Send(&pb.RangeStreamResponse{RangeResponse: resp}); err != nil {
+			return err
+		}
+		if final {
+			return nil
+		}
+		// Appending a zero byte is the exclusive successor of the last key.
+		req.Key = append(append([]byte(nil), resp.Kvs[len(resp.Kvs)-1].Key...), 0)
+		target := int64(s.Cfg.MaxRequestBytes)
+		if int64(size) > target {
+			limit = max(int64(1), limit/2)
+		} else if more && int64(size) < target/2 {
+			// Saturate growth to avoid overflowing the per-chunk key limit.
+			if limit <= (1<<62)-1 {
+				limit *= 2
+			}
+		}
+		if r.Limit > 0 {
+			limit = min(limit, r.Limit-sent)
+		}
+	}
+}
