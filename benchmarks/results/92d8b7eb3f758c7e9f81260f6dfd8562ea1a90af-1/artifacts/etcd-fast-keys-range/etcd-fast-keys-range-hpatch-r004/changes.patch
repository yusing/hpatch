+// rangeKeysOnly returns key metadata directly from the index. Results are
+// sorted by key and limited when limit is positive. When withTotalCount is
+// true, scanning continues after the limit to count all live keys.
+func (ti *treeIndex) rangeKeysOnly(key, end []byte, atRev int64, limit int, withTotalCount bool) (keys [][]byte, modifies, creates []Revision, versions []int64, total int) {
+	ti.RLock()
+	defer ti.RUnlock()
+
+	if end == nil {
+		modified, created, version, err := ti.unsafeGet(key, atRev)
+		if err != nil {
+			return nil, nil, nil, nil, 0
+		}
+		return [][]byte{key}, []Revision{modified}, []Revision{created}, []int64{version}, 1
+	}
+	ti.unsafeVisit(key, end, func(ki *keyIndex) bool {
+		reachedLimit := limit > 0 && len(keys) >= limit
+		if reachedLimit && !withTotalCount {
+			return false
+		}
+		if modified, created, version, err := ki.get(ti.lg, atRev); err == nil {
+			if !reachedLimit {
+				keys = append(keys, ki.key)
+				modifies = append(modifies, modified)
+				creates = append(creates, created)
+				versions = append(versions, version)
+			}
+			total++
+		}
+		return true
+	})
+	return keys, modifies, creates, versions, total
+}
