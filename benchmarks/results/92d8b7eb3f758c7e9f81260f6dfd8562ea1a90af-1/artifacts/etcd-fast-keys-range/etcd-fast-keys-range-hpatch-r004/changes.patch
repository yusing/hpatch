+type fastKeysOnlyIndex interface {
+	rangeKeysOnly(key, end []byte, atRev int64, limit int, withTotalCount bool) (keys [][]byte, modifies, creates []Revision, versions []int64, total int)
+}
+
+func rangeKeysOnlyFromIndex(idx index, key, end []byte, atRev int64, limit int, withTotalCount bool) (keys [][]byte, modifies, creates []Revision, versions []int64, total int) {
+	if koi, ok := idx.(fastKeysOnlyIndex); ok {
+		return koi.rangeKeysOnly(key, end, atRev, limit, withTotalCount)
+	}
+
+	// Keep alternate index implementations compatible. Production uses
+	// treeIndex and takes the optimized path above.
+	allKeys, _ := idx.Range(key, end, atRev)
+	for _, key := range allKeys {
+		modified, created, version, err := idx.Get(key, atRev)
+		if err != nil {
+			continue
+		}
+		if limit <= 0 || len(keys) < limit {
+			keys = append(keys, key)
+			modifies = append(modifies, modified)
+			creates = append(creates, created)
+			versions = append(versions, version)
+		} else if !withTotalCount {
+			break
+		}
+		total++
+	}
+	return keys, modifies, creates, versions, total
+}
