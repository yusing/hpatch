+	appendKey := func(key []byte, modified, created Revision, version int64) bool {
+		if limit <= 0 || len(kvs) < limit {
+			kvs = append(kvs, indexKeyValue{
+				key:      key,
+				modified: modified,
+				created:  created,
+				version:  version,
+			})
+		}
+		total++
+		return withTotalCount || limit <= 0 || len(kvs) < limit
+	}
+
+	if end == nil {
+		modified, created, version, err := ti.unsafeGet(key, atRev)
+		if err != nil {
+			return nil, 0
+		}
+		appendKey(key, modified, created, version)
+		return kvs, total
+	}
+	ti.unsafeVisit(key, end, func(ki *keyIndex) bool {
+		modified, created, version, err := ki.get(ti.lg, atRev)
+		if err != nil {
+			return true
+		}
+		return appendKey(ki.key, modified, created, version)
+	})
+	return kvs, total
+}
