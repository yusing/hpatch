+type fastRangeIndex interface {
+	RangeFast(key, end []byte, atRev int64, limit int, withTotalCount bool) (keys [][]byte, modifies, creates []Revision, versions []int64, totalCount int)
+}
+
+func rangeKeysFromIndex(idx index, key, end []byte, atRev int64, limit int, withTotalCount bool) (keys [][]byte, modifies, creates []Revision, versions []int64, totalCount int) {
+	if fastIdx, ok := idx.(fastRangeIndex); ok {
+		return fastIdx.RangeFast(key, end, atRev, limit, withTotalCount)
+	}
+
+	allKeys, _ := idx.Range(key, end, atRev)
+	totalCount = len(allKeys)
+	if limit > 0 && len(allKeys) > limit {
+		allKeys = allKeys[:limit]
+		if !withTotalCount {
+			totalCount = limit
+		}
+	}
+	for _, key := range allKeys {
+		modified, created, version, err := idx.Get(key, atRev)
+		if err != nil {
+			continue
+		}
+		keys = append(keys, key)
+		modifies = append(modifies, modified)
+		creates = append(creates, created)
+		versions = append(versions, version)
+	}
+	return keys, modifies, creates, versions, totalCount
+}
