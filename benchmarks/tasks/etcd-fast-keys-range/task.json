{
  "version": 1,
  "id": "etcd-fast-keys-range",
  "source": {
    "repository": "../../repos/etcd",
    "base_commit": "27d5ef1b4da1d76ca8b9421d667e87d2fd2aba9d",
    "oracle_commit": "dd57ad39fa4eb1afcd9abdadf75354bca0600d9f"
  },
  "prompt_file": "prompt.md",
  "runtime": {
    "dependency_kind": "go",
    "preload_go_qualification_grader": true
  },
  "hidden_files": [
    {
      "source": "hidden_mvcc_test.go.txt",
      "destination": "server/storage/mvcc/hpatch_benchmark_test.go"
    },
    {
      "source": "hidden_txn_test.go.txt",
      "destination": "server/etcdserver/txn/hpatch_benchmark_test.go"
    }
  ],
  "graders": [
    {
      "name": "fast-keys-range",
      "command": [
        "go",
        "test",
        "./server/storage/mvcc",
        "./server/etcdserver/txn",
        "-run",
        "^TestHPatchBenchmark",
        "-count=1"
      ],
      "required": true,
      "expect_base": "fail",
      "baseline_output_contains": "FastKeysOnly option is missing",
      "timeout_seconds": 300
    }
  ],
  "allowed_path_prefixes": [
    "server/etcdserver/txn/range.go",
    "server/storage/mvcc/index.go",
    "server/storage/mvcc/kv.go",
    "server/storage/mvcc/kvstore_txn.go"
  ],
  "agent_timeout_seconds": 900
}
